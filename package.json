{
  "name": "luminekit",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "check": "npm run check:skills && npm run check:links",
    "check:skills": "node scripts/check-skills.mjs",
    "check:links": "remark README.md AGENTS.md skills --frail --no-stdout --quiet",
    "skills:list": "skills add . --list",
    "test": "npm run check && npm run test:install",
    "test:install": "node scripts/test-install.mjs"
  },
  "devDependencies": {
    "remark-cli": "12.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-validate-links": "13.1.0",
    "skills": "1.7.6",
    "yaml": "2.9.1"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
